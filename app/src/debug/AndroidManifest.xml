<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only (v2 P1): lets emulator tests drive the app without fragile taps. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tim.sleeptimer.debug.START" />
                <action android:name="com.tim.sleeptimer.debug.SET" />
                <action android:name="com.tim.sleeptimer.debug.STOP" />
                <action android:name="com.tim.sleeptimer.debug.ACTION" />
                <action android:name="com.tim.sleeptimer.debug.DUMP" />
                <action android:name="com.tim.sleeptimer.debug.VOLUME" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
